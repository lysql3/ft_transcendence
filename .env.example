# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and fill in the values for your environment.
# ==============================================================================

# Compose overrides NODE_ENV for each stack; keep this default for local commands.
NODE_ENV=development

# PostgreSQL Database Configuration
POSTGRES_USER=transcendence
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=transcendence
POSTGRES_PORT=5432
ADMINER_PORT=8080

# Backend NestJS Configuration
PORT=3000
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
BETTER_AUTH_SECRET=generate-a-long-random-value
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Frontend host ports
FRONTEND_DEV_PORT=5173
FRONTEND_PROD_PORT=443
FRONTEND_HTTP_PORT=80
BACKEND_URL=http://backend:3000

# Judge0
JUDGE0_URL=http://judge0:2358
JUDGE0_AUTH_TOKEN=d4dcfeb8285a36511a8aa1918a275d959d6ba81f6d5f82f4d5debfd4da875639
