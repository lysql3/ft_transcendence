# ==============================================================================
# Production Environment Configuration
# Used by docker-compose.prod.yml
# NOTE: Replace placeholder passwords and secrets before real production deploy!
# ==============================================================================

NODE_ENV=production

# PostgreSQL Database Configuration
POSTGRES_USER=transcendence_admin
POSTGRES_PASSWORD=supersecret_production_password_change_me
POSTGRES_DB=transcendence_prod
POSTGRES_PORT=5432

# Backend NestJS Configuration
PORT=3000
DATABASE_URL=postgresql://transcendence_admin:supersecret_production_password_change_me@postgres:5432/transcendence_prod

# Frontend Configuration (Nginx host port)
FRONTEND_PORT=443
FRONTEND_HTTP_PORT=80
BACKEND_URL=http://backend:3000
